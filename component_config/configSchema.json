{
  "type": "object",
  "title": "X Ads Extractor configuration",
  "properties": {
    "#consumer_key": {
      "type": "string",
      "title": "Consumer API Key",
      "format": "password",
      "required": true,
      "propertyOrder": 1
    },
    "#consumer_secret": {
      "type": "string",
      "title": "Consumer API Secret",
      "format": "password",
      "required": true,
      "propertyOrder": 2
    },
    "#access_token": {
      "type": "string",
      "title": "Access Token",
      "format": "password",
      "required": true,
      "propertyOrder": 3
    },
    "#access_token_secret": {
      "type": "string",
      "title": "Access Token Secret",
      "format": "password",
      "required": true,
      "propertyOrder": 4
    },
    "test_connection": {
      "type": "button",
      "format": "test-connection",
      "propertyOrder": 5,
      "options": {
        "async": {
          "label": "Test Connection",
          "action": "testConnection"
        }
      }
    },
    "account_ids": {
      "type": "array",
      "title": "Ad Accounts",
      "items": {
        "type": "string",
        "enum": []
      },
      "format": "select",
      "uniqueItems": true,
      "default": [],
      "description": "Select the X (Twitter) Ads accounts to extract data for.",
      "propertyOrder": 6,
      "options": {
        "tags": true,
        "async": {
          "label": "Load Accounts",
          "action": "listAccounts",
          "autoload": ["#consumer_key", "#consumer_secret", "#access_token", "#access_token_secret"]
        }
      }
    },
    "objects": {
      "type": "array",
      "title": "Objects to extract",
      "items": {
        "type": "string",
        "enum": [
          "accounts",
          "funding_instruments",
          "campaigns",
          "line_items",
          "promoted_tweets",
          "promoted_accounts",
          "media_creatives"
        ]
      },
      "format": "select",
      "uniqueItems": true,
      "default": [],
      "description": "Campaign-management entities to extract as tables.",
      "propertyOrder": 7,
      "options": {
        "enum_titles": [
          "Accounts",
          "Funding Instruments",
          "Campaigns",
          "Line Items",
          "Promoted Tweets",
          "Promoted Accounts",
          "Media Creatives"
        ]
      }
    },
    "analytics": {
      "type": "object",
      "title": "Analytics",
      "propertyOrder": 8,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable analytics",
          "format": "checkbox",
          "default": false,
          "propertyOrder": 1
        },
        "entities": {
          "type": "array",
          "title": "Entities",
          "items": {
            "type": "string",
            "enum": [
              "ACCOUNT",
              "FUNDING_INSTRUMENT",
              "CAMPAIGN",
              "LINE_ITEM",
              "PROMOTED_TWEET",
              "PROMOTED_ACCOUNT"
            ]
          },
          "format": "select",
          "uniqueItems": true,
          "default": [],
          "description": "Entity levels to pull performance stats for. Each selected level produces an x_ads_stats_&lt;entity&gt; table (e.g. Line Item → per-line-item metrics). Docs: https://docs.x.com/x-ads-api/analytics",
          "propertyOrder": 2,
          "options": {
            "enum_titles": [
              "Account",
              "Funding Instrument",
              "Campaign",
              "Line Item",
              "Promoted Tweet",
              "Promoted Account"
            ],
            "dependencies": {
              "enabled": true
            }
          }
        },
        "metric_groups": {
          "type": "array",
          "title": "Metric groups",
          "items": {
            "type": "string",
            "enum": [
              "ENGAGEMENT",
              "BILLING",
              "VIDEO",
              "MEDIA",
              "WEB_CONVERSION",
              "MOBILE_CONVERSION",
              "LIFE_TIME_VALUE_MOBILE_CONVERSION"
            ]
          },
          "format": "select",
          "uniqueItems": true,
          "default": [
            "ENGAGEMENT",
            "BILLING"
          ],
          "description": "Which metric families to fetch. Engagement = impressions/clicks/likes/retweets/etc.; Billing = spend & billed charges; Video = view quartiles; Media = media views/engagements; Web/Mobile Conversion = conversion events. Docs: https://docs.x.com/x-ads-api/analytics/metrics-and-segmentation",
          "propertyOrder": 3,
          "options": {
            "enum_titles": [
              "Engagement",
              "Billing",
              "Video",
              "Media",
              "Web Conversion",
              "Mobile Conversion",
              "Life Time Value Mobile Conversion"
            ],
            "dependencies": {
              "enabled": true
            }
          }
        },
        "granularity": {
          "type": "string",
          "title": "Granularity",
          "enum": [
            "DAY",
            "TOTAL",
            "HOUR"
          ],
          "default": "DAY",
          "description": "Time bucketing for the metrics: Day = one row per day, Hour = one row per hour, Total = a single aggregate over the whole date range.",
          "propertyOrder": 4,
          "options": {
            "enum_titles": [
              "Day",
              "Total",
              "Hour"
            ],
            "dependencies": {
              "enabled": true
            }
          }
        },
        "placement": {
          "type": "string",
          "title": "Placement",
          "enum": [
            "ALL_ON_TWITTER",
            "PUBLISHER_NETWORK"
          ],
          "default": "ALL_ON_TWITTER",
          "description": "Where the ads were served — 'All on Twitter' (on X itself) or the 'Publisher Network' (X Audience Platform / off-X placements). Metrics are reported separately per placement, so pick the surface you want to measure.",
          "propertyOrder": 5,
          "options": {
            "enum_titles": [
              "All on Twitter",
              "Publisher Network"
            ],
            "dependencies": {
              "enabled": true
            }
          }
        },
        "date_range_mode": {
          "type": "string",
          "title": "Date range mode",
          "enum": [
            "last_n_days",
            "custom"
          ],
          "default": "last_n_days",
          "propertyOrder": 6,
          "options": {
            "enum_titles": [
              "Last N Days",
              "Custom Date Range"
            ],
            "dependencies": {
              "enabled": true
            }
          }
        },
        "n_days": {
          "type": "integer",
          "title": "Number of days",
          "default": 7,
          "minimum": 1,
          "maximum": 90,
          "description": "Number of trailing days (including today) to fetch analytics for.",
          "propertyOrder": 7,
          "options": {
            "dependencies": {
              "enabled": true,
              "date_range_mode": "last_n_days"
            }
          }
        },
        "start_date": {
          "type": "string",
          "title": "Start date",
          "description": "Window start. Accepts an absolute date (YYYY-MM-DD) or a relative expression like 'yesterday', '30 days ago' or 'last monday'.",
          "propertyOrder": 8,
          "options": {
            "inputAttributes": {
              "placeholder": "YYYY-MM-DD or e.g. 30 days ago"
            },
            "dependencies": {
              "enabled": true,
              "date_range_mode": "custom"
            }
          }
        },
        "end_date": {
          "type": "string",
          "title": "End date",
          "description": "Window end (exclusive). Accepts an absolute date (YYYY-MM-DD) or a relative expression like 'today' or 'yesterday'.",
          "propertyOrder": 9,
          "options": {
            "inputAttributes": {
              "placeholder": "YYYY-MM-DD or e.g. today"
            },
            "dependencies": {
              "enabled": true,
              "date_range_mode": "custom"
            }
          }
        }
      }
    },
    "load_type": {
      "type": "string",
      "title": "Load type",
      "enum": [
        "full_load",
        "incremental_load"
      ],
      "default": "incremental_load",
      "description": "How data is written to the destination tables.",
      "propertyOrder": 9,
      "options": {
        "tooltip": "**Full load** overwrites the destination tables on every run.\n\n**Incremental load** upserts rows based on the primary key, keeping previously loaded data.",
        "enum_titles": [
          "Full Load",
          "Incremental Load"
        ]
      }
    }
  }
}
